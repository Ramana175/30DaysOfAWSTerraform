# ==========================
# Terraform
# ==========================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

# Terraform lock file
# Uncomment if you do NOT want to track provider versions
# .terraform.lock.hcl

# ==========================
# Sensitive Files
# ==========================

# Private keys
*.pem
*.ppk
*.key

# AWS credentials
.aws/

# Environment files
.env
.env.*

# ==========================
# IDE Files
# ==========================

# VS Code
.vscode/

# IntelliJ / PyCharm
.idea/

# Eclipse
.project
.classpath
.settings/

# ==========================
# OS Files
# ==========================

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# ==========================
# Logs
# ==========================

*.log

# ==========================
# Temporary Files
# ==========================

*.tmp
*.temp
```gitignore
# Terraform cache
.terraform/

# Terraform lock file
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Variable files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan

# CLI config files
.terraformrc
terraform.rc

# Sensitive files
config.json

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
```
